# ==============================================================================
# CONFIGURACIÓN DEL ASISTENTE HÍBRIDO (LOCAL .GGUF + AZURE FOUNDRY CLOUD)
# ==============================================================================

# Selector de proveedor por defecto: 'auto', 'local' o 'azure'
AI_PROVIDER=auto

# ------------------------------------------------------------------------------
# 1) CONFIGURACIÓN LOCAL (.GGUF con llama.cpp)
# ------------------------------------------------------------------------------
# Carpeta donde tienes guardados tus archivos .gguf:
MODELS_DIR=./models

# Opcional: Ruta directa a un modelo .gguf específico
# LOCAL_MODEL_PATH=C:/ruta/a/tu/modelo.gguf

# Contexto máximo en tokens (2048 o 4096 es recomendado)
LOCAL_N_CTX=4096

# Aceleración por GPU:
# 0 = Solo CPU
# -1 = Descargar todas las capas posibles a tu GPU NVIDIA
LOCAL_N_GPU_LAYERS=0

# ------------------------------------------------------------------------------
# 2) CONFIGURACIÓN CLOUD (MICROSOFT AZURE FOUNDRY)
# ------------------------------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=tu_endpoint_de_azure_aqui
MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# ------------------------------------------------------------------------------
# TEMA Y PERSONALIZACIÓN DE LA INTERFAZ
# ------------------------------------------------------------------------------
PROJECT_THEME=JujutsuKaisen
